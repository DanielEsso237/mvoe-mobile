{
  "expo": {
    "name": "Mvoe Mobile",
    "slug": "mvoe-mobile",
    "scheme": "mvoe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "android": {
      "package": "com.mvoe.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59e950d2-c950-4cea-b120-99a95dda67ee"
      }
    }
  }
}
